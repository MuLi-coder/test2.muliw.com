{
  "version": 2,
  "builds": [
    { "src": "api/index.ts", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "src": "/style.css(?:\\?.*)?", "dest": "/public/style.css" },
    { "src": "/game.js(?:\\?.*)?", "dest": "/public/game.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
