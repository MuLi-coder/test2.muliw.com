# Set this in Vercel Project Settings > Environment Variables.
# Use the private Redis connection URL (redis:// or rediss://); do not commit real credentials.
REDIS_URL=rediss://default:replace-with-password@your-redis-host:6379

# Each game expires after this many seconds since its most recent update (default: 86400 / 24 hours).
GAME_TTL_SECONDS=86400
